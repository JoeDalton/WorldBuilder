# LF (linux) takes precedence by default
* text=auto eol=lf

# Windows-only scripts: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: don't touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.glb binary
*.bin binary
*.blend binary
*.fbx binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.wav binary
*.ogg binary
*.mp3 binary

# GitHub tag archives fill this in, so a zip install knows its version. Keep
# %D (ref names) out of it: they change as branches move, and the zip's hash
# with them, which breaks any lock file that pinned it.
.git_archival.json export-subst
